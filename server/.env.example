# SocialSphere Backend - Environment Variables Template
# Copy this file to .env or configure these variables in Render Dashboard

# Deployment Environment
NODE_ENV=production
PORT=10000

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://username:password@ep-example.us-east-2.aws.neon.tech/socialsphere?sslmode=require

# JWT Secrets for Authentication
JWT_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

# Frontend Client URL (e.g. your Render Static Site URL or custom domain)
# Multiple origins can be separated by commas (e.g. https://socialsphere.onrender.com,http://localhost:5173)
CLIENT_URL=https://your-frontend-app.onrender.com

# AI Suggest Provider - OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Razorpay Payment Gateway (Test Mode / Live Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary Media Storage (Images, Videos, Avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Firebase Admin (Optional - for Google Sign-In)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
