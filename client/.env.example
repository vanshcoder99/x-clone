# SocialSphere Frontend - Environment Variables Template
# Copy this file to .env or configure these variables in Render Dashboard

# Backend API URL (Your Render Backend Web Service URL)
# Note: You can provide with or without "/api" (both work seamlessly)
VITE_API_URL=https://your-backend-app.onrender.com/api

# Realtime WebSocket Server URL (usually the root of your backend service)
VITE_SOCKET_URL=https://your-backend-app.onrender.com

# Razorpay Key ID (Client-safe public key, starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_TGHpX4BZjPN9jC

# GIPHY API Public Key for GIF search in composer
VITE_GIPHY_API_KEY=sXpGFDGZs0Dv1mmNFvYaGUvYwKX0PWIh

# Google Firebase Client Configuration (Optional - for Google Sign-In)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

